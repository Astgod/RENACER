# Variables de entorno — Renacer de la Espiga
# Copia este archivo como ".env" y completa con los datos reales.
# NO subas el archivo .env real al repositorio (está en .gitignore).

# Número de WhatsApp en formato internacional sin "+" ni espacios
# Ejemplo: 56912345678
WHATSAPP_NUMERO=56900000000

# Email de contacto del negocio
EMAIL_CONTACTO=hola@renacerdelaespiga.cl

# ID del formulario de Formspree (https://formspree.io)
# Se usa en el atributo action del formulario: https://formspree.io/f/XXXXXXXX
FORMSPREE_ID=TU_FORM_ID
